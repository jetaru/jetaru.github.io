# URL del servidor externo en JavaScript / Node.js
# Si está vacío o inaccesible, la aplicación conmuta automáticamente al repositorio Mock local
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# EmailJS Configuration
# Clave Pública (Account Public Key) para envío directo client-side
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=fc4QxiMiBJhDBwCbH

# ID del Servicio de Email configurado en EmailJS (Gmail)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_gmail_jeta_us

# ID de la Plantilla de Email en EmailJS (Email Templates)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_jetaru

# Path base en caso de ser necesario (para jetaru.github.io la raíz es vacía "")
NEXT_PUBLIC_BASE_PATH=
